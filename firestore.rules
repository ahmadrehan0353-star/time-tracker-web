rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The sales form can create new leads without logging in, but only the
    // authenticated admin can read, update (mark read/archive), or delete them.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
